# The dashboard's whole configuration surface. Copy to `.env.local`.
#
# Both values are required, and the app throws at import when either is
# missing. There is no offline mode: the dashboard is a client of the PayHold
# API, and until recently an unset URL meant "run the in-browser mock", which
# made a misconfigured deploy look exactly like a working demo. The mock is
# gone and so is that ambiguity.
#
# Everything here ends up readable in the built bundle, and that is fine — the
# dashboard holds no secrets and has no direct database access. The
# service-role key must NEVER appear in this file or any other under this
# directory; it lives in Supabase's function secrets and nowhere else.

VITE_SUPABASE_URL=https://mwnbjjlilqrwdmwutbxr.supabase.co

# The anon key. Not a credential: it identifies the project to the auth server
# and authorises nothing on its own. Every real check is the session JWT, or
# the API key a client's server holds.
VITE_SUPABASE_ANON_KEY=
